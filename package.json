{
  "name": "@acegalaxy/lib-voice-gateway",
  "version": "0.2.0",
  "description": "OpenAI Whisper wrapper with cost cap, rate limit, default-deny authz, queue, and audit log. Production-ready STT for Telegram bots.",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "tsc",
    "clean": "rm -rf dist",
    "pretest": "npm run build"
  },
  "keywords": [
    "voice",
    "stt",
    "whisper",
    "openai",
    "telegram",
    "cost-cap",
    "rate-limit"
  ],
  "author": "ACE Galaxy <hello@acegalaxy.co>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": "github:acegalaxy-co/lib-voice-gateway",
  "bugs": {
    "url": "https://github.com/acegalaxy-co/lib-voice-gateway/issues"
  },
  "homepage": "https://github.com/acegalaxy-co/lib-voice-gateway#readme",
  "dependencies": {
    "@acegalaxy/lib-security-utils": "github:acegalaxy-co/lib-security-utils#v0.3.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sources/telegram": {
      "types": "./dist/sources/telegram.d.ts",
      "default": "./dist/sources/telegram.js"
    },
    "./sources/*": {
      "types": "./dist/sources/*.d.ts",
      "default": "./dist/sources/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.0.0"
  }
}