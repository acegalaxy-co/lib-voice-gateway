{
  "name": "@acegalaxy/voice-gateway",
  "version": "0.1.0",
  "description": "OpenAI Whisper wrapper with cost cap, rate limit, default-deny authz, queue, and audit log. Production-ready STT for Telegram bots.",
  "main": "dist/index.js",
  "scripts": {
    "test": "node smoke.test.js",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "voice",
    "stt",
    "whisper",
    "openai",
    "telegram",
    "cost-cap",
    "rate-limit"
  ],
  "author": "ACE Galaxy <hello@acegalaxy.co>",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acegalaxy-co/ace_commons-voice-gateway-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/acegalaxy-co/ace_commons-voice-gateway-nodejs/issues"
  },
  "homepage": "https://github.com/acegalaxy-co/ace_commons-voice-gateway-nodejs#readme",
  "dependencies": {
    "@acegalaxy/security-utils": "file:../ace_commons-security-utils-nodejs"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sources/telegram": {
      "types": "./dist/sources/telegram.d.ts",
      "default": "./dist/sources/telegram.js"
    },
    "./sources/*": {
      "types": "./dist/sources/*.d.ts",
      "default": "./dist/sources/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.0.0"
  }
}
